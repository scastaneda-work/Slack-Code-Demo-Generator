# Off by default. The master gate — Slack Code is a beta your Slack workspace
# must have enabled before this bot's Slack Code channel features will work.
SLACK_CODE_ENABLED=

# Off by default. Enables the in-thread lightweight Claude Tag collaboration
# surface (ambient @-mention corrections in ordinary channels).
SLACK_TAG_ENABLED=

# Which Slack Code demo scenario to run. Blank defaults to website_redesign.
SLACK_CODE_SCENARIO=

# Leave blank: public model default set in agent/agent.py; internal SEs may
# set us.anthropic.claude-sonnet-5
CLAUDE_AI_MODEL=

# Channel ID for audit logging (e.g. #claude-demo-changes-log). When unset,
# audit_log() silently no-ops. The bot's bot token must be a member of this
# channel.
AUDIT_CHANNEL_ID=

# A demo-admin name to mask in audit posts; blank = no masking.
DEMO_ADMIN_NAME=

# Slack Enterprise Grid workspace team ID (a T… id). Needed on Grid orgs
# because users.lookupByEmail/users.list require it and auth.test returns the
# enterprise (E…) id instead.
SLACK_WORKSPACE_TEAM_ID=

# Numeric suffix identifying your demo org, used to derive
# demoeng+<stem>_<orgnum>@slack-corp.com style lookup emails.
SLACK_DEMO_ORG_NUM=

# Fake repo name/slug shown in Slack Code's context bar and artifacts.
SLACK_CODE_FAKE_REPO=

# Prefix used when naming newly created Slack Code channels.
SLACK_CODE_CHANNEL_PREFIX=

# only if you are NOT using a local `claude` CLI login
# ANTHROPIC_API_KEY=
