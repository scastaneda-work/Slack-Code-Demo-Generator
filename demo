#!/usr/bin/env bash
# Manage your demos: ./demo for the terminal UI, ./demo --help for the commands.
set -e
cd "$(dirname "$0")"
if [ ! -x .venv/bin/python ]; then
  echo "[demo] No .venv yet. Build it first (SETUP.md Step 5):" >&2
  echo "  python3.12 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi
exec .venv/bin/python -m demokit "$@"
